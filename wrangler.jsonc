{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nickebert-co",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/atom-visualizer",
      "/atom-visualizer/*",
      "/unsure-calculator",
      "/unsure-calculator/*"
    ]
  },
  "routes": [
    { "pattern": "nickebert.co", "custom_domain": true },
    { "pattern": "www.nickebert.co", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
